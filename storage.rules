rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── custom_designs/{uid}/{filename} — user design uploads ─────────
    //
    // Written by:  upload_service.dart  (ref('custom_designs/{uid}/{fileName}').putData())
    // Each authenticated user may read and write only their own folder.
    // Uploads are restricted to images no larger than 10 MB so the bucket
    // cannot be abused to host arbitrary files.
    match /custom_designs/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
