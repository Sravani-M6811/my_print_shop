app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase client config & generated keys
google_services.json.json
**/google-services.json
**/GoogleService-Info.plist

# Environment files & secret key material
.env
.env.*
*.env
scripts/.pexels_key
scripts/.pexels_*

# Never commit: real .env files. Only the placeholder template is tracked.
!**/.env.example
!/.env.example

# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
**/serviceAccount*.json
**/service-account*.json
**/*firebase-adminsdk*.json

# Build output that embeds the Google/Firebase API key (regenerated locally)
android/app/build/
**/build/
.firebase/

# Backend runtime state & dependencies
backend/printshop.db*
backend/uploads/
/node_modules/
/backend/node_modules/
