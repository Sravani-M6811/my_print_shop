# Copy to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env     (macOS/Linux)
#   Copy-Item backend/.env.example backend\.env   (PowerShell)
#
# backend/.env is git-ignored. NEVER commit real values here.
# Real environment variables take precedence over this file.

# --- Server ---
# Port the Express API listens on.
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
# Leave unset to allow localhost/127.0.0.1 on any port only.
# CORS_ORIGINS=https://your-shop.web.app,https://your-domain.com

# --- Admin ---
# Shared secret for the admin endpoints. Sent as the `x-admin-key` header.
# Must be at least 16 characters; the server FAILS CLOSED (503) if unset/short.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# --- Razorpay (payments) ---
# KEY_ID is the public id (safe for client code) and is used to build the
# Basic auth header. KEY_SECRET is the true secret: server-side only, used for
# signature verification. Never expose KEY_SECRET to any client.
# Test keys look like rzp_test_..., live keys like rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI assistant (local Ollama) ---
# Base URL of the Ollama server and the model to use.
# Defaults shown are used when the variables are unset.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
